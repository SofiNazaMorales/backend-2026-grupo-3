{
  "info": {
    "name": "Backend Grupo 3 - 6 casos de evaluación",
    "description": "Ejecutar después de migraciones y seeder. Base URL configurable. El caso 02 permite detener y reiniciar Uvicorn entre POST y GET. El script verificar_persistencia.py realiza esa comprobación automáticamente con procesos HTTP reales.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "function localDate(d) { return d.getFullYear()+\"-\"+String(d.getMonth()+1).padStart(2,\"0\")+\"-\"+String(d.getDate()).padStart(2,\"0\"); }",
          "const now = new Date();",
          "pm.collectionVariables.set(\"hoy\", localDate(now));",
          "const next = new Date(now); next.setDate(next.getDate()+1); pm.collectionVariables.set(\"manana\", localDate(next));",
          "const old = new Date(now); old.setDate(old.getDate()-20); pm.collectionVariables.set(\"fecha_antigua\", localDate(old));",
          "if (!pm.collectionVariables.get(\"run_id\")) pm.collectionVariables.set(\"run_id\", String(Date.now()));",
          "if (!pm.collectionVariables.get(\"rut_prueba\")) {",
          "  const body = String(10000000 + Math.floor(Math.random()*80000000));",
          "  let sum=0, factor=2; for(let i=body.length-1;i>=0;i--) { sum += Number(body[i])*factor; factor=factor===7?2:factor+1; }",
          "  const dv=11-(sum%11); pm.collectionVariables.set(\"rut_prueba\",body+\"-\"+(dv===11?\"0\":dv===10?\"K\":String(dv)));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - CRUD de Estudiantes",
      "item": [
        {
          "name": "Crear estudiante",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/estudiantes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rut_estudiante\": \"{{rut_prueba}}\",\n  \"nombre\": \"Ana\",\n  \"apellido\": \"Prueba\",\n  \"email_institucional\": \"prueba.{{run_id}}@alu.uct.cl\",\n  \"id_carrera\": \"ICI-INF\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Contrato global\", function () { const r=pm.response.json(); pm.expect(r.success).to.eql(true); pm.expect(typeof r.message).to.eql(\"string\"); });",
                  "pm.collectionVariables.set(\"rut_prueba\", pm.response.json().data.rut_estudiante);"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar estudiante",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/estudiantes/{{rut_prueba}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Contrato global\", function () { const r=pm.response.json(); pm.expect(r.success).to.eql(true); pm.expect(typeof r.message).to.eql(\"string\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar estudiante",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/estudiantes/{{rut_prueba}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana María\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Contrato global\", function () { const r=pm.response.json(); pm.expect(r.success).to.eql(true); pm.expect(typeof r.message).to.eql(\"string\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Eliminar estudiante sin justificativos",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/estudiantes/{{rut_prueba}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Comprobar eliminación",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/estudiantes/{{rut_prueba}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 404\", function () { pm.response.to.have.status(404); });",
                  "pm.test(\"Contrato global\", function () { const r=pm.response.json(); pm.expect(typeof r.error.code).to.eql(\"string\"); pm.expect(typeof r.error.message).to.eql(\"string\"); pm.expect(r.error.details).to.be.an(\"array\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
